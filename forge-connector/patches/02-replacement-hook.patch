Effect-record hook 2: the shared replacement execution point.

A replacement effect rewrites an event: "would be dealt damage" becomes "is dealt
half that damage", or nothing at all. The corpus records the incoming and the
outgoing event as one `rewrite` record, and there is no way to observe the pair
from the bus — only the outgoing event is fired.

This hook adds a listener at `executeReplacement`, the one point every
replacement passes through, called with the parameter map before and after.

**The parameter map must be deep-copied before the call.** The handler's own
copy is shallow, and replacements mutate nested structures in place, so a
shallow copy would record the outgoing values in both slots and every rewrite
record would say the effect changed nothing.

--- a/forge-game/src/main/java/forge/game/replacement/ReplacementHandler.java
+++ b/forge-game/src/main/java/forge/game/replacement/ReplacementHandler.java
@@ -50,6 +50,40 @@ public class ReplacementHandler {
     private final Game game;

+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+
+    /** Notified around every replacement execution. */
+    public interface EffectRecordListener {
+        void onReplacement(
+                ReplacementEffect effect,
+                Map<AbilityKey, Object> before,
+                Map<AbilityKey, Object> after);
+    }
+
+    private static EffectRecordListener effectRecordListener;
+
+    public static void setEffectRecordListener(final EffectRecordListener listener) {
+        effectRecordListener = listener;
+    }
+
+    /**
+     * Deep-copy of a run-parameter map, for the "before" side.
+     *
+     * Replacements mutate the nested structures in place, so a shallow copy
+     * would leave both sides showing the outgoing values and every rewrite
+     * record would claim the effect changed nothing.
+     */
+    private static Map<AbilityKey, Object> deepCopyParams(
+            final Map<AbilityKey, Object> params) {
+        final Map<AbilityKey, Object> copy = new EnumMap<>(AbilityKey.class);
+        for (final Map.Entry<AbilityKey, Object> entry : params.entrySet()) {
+            final Object value = entry.getValue();
+            if (value instanceof Map<?, ?> nested) {
+                copy.put(entry.getKey(), new java.util.LinkedHashMap<>(nested));
+            } else if (value instanceof java.util.Collection<?> nested) {
+                copy.put(entry.getKey(), new java.util.ArrayList<>(nested));
+            } else {
+                copy.put(entry.getKey(), value);
+            }
+        }
+        return copy;
+    }
+
     public ReplacementHandler(Game gameState) {
         game = gameState;
     }
