@@ -60,6 +60,32 @@ public class TriggerHandler {
     private final List<Trigger> activeTriggers = Lists.newArrayList();

+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+    //
+    // The trigger currently being run, per thread. Effect-record collection
+    // reads it to attribute an event to the trigger that produced it rather
+    // than to whatever happened to be resolving at the time. Null outside a
+    // trigger run. A plain static so the connector can read it reflectively
+    // and keep building against an unpatched checkout.
+    private static final ThreadLocal<Trigger> EFFECT_RECORD_CAUSE =
+            new ThreadLocal<>();
+
+    /** The trigger currently running on this thread, or null. */
+    public static Trigger getEffectRecordCause() {
+        return EFFECT_RECORD_CAUSE.get();
+    }
+
+    /** Set by the handler around a trigger run; restored in a finally. */
+    public static void setEffectRecordCause(final Trigger trigger) {
+        if (trigger == null) {
+            EFFECT_RECORD_CAUSE.remove();
+        } else {
+            EFFECT_RECORD_CAUSE.set(trigger);
+        }
+    }
+
