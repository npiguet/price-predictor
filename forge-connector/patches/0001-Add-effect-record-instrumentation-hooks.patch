+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+
+    /** Notified around every replacement execution. */
+    public interface EffectRecordListener {
+        void onReplacement(ReplacementEffect effect, Map<AbilityKey, Object> before,
+                Map<AbilityKey, Object> after);
+    }
+
+    private static EffectRecordListener effectRecordListener;
+
+    public static void setEffectRecordListener(final EffectRecordListener listener) {
+        effectRecordListener = listener;
+    }
+
+    /**
+     * Deep-copy of a run-parameter map, for the "before" side.
+     *
+     * <p>Replacements mutate the nested structures in place, so a shallow copy
+     * would leave both sides showing the outgoing values and every rewrite
+     * record would claim the effect changed nothing.
+     */
+    private static Map<AbilityKey, Object> deepCopyParams(final Map<AbilityKey, Object> params) {
+        final Map<AbilityKey, Object> copy = new EnumMap<>(AbilityKey.class);
+        for (final Map.Entry<AbilityKey, Object> entry : params.entrySet()) {
+            final Object value = entry.getValue();
+            if (value instanceof Map<?, ?> nested) {
+                copy.put(entry.getKey(), new LinkedHashMap<>(nested));
+            } else if (value instanceof Collection<?> nested) {
+                copy.put(entry.getKey(), new ArrayList<>(nested));
+            } else {
+                copy.put(entry.getKey(), value);
+            }
+        }
+        return copy;
+    }
+
