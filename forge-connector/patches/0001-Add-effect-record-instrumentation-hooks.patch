+++ b/forge-game/src/main/java/forge/game/ability/AbilityUtils.java
@@ -1296,11 +1296,43 @@ public class AbilityUtils {
     // BELOW ARE resolve() METHOD AND ITS DEPENDANTS, CONSIDER MOVING TO DEDICATED CLASS
     //
     /////////////////////////////////////////////////////////////////////////////////////
+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+    //
+    // The sub-ability currently resolving on this thread, or null at the root.
+    // Read by effect-record collection to attribute an outcome to the clause
+    // that produced it rather than to the whole line: "put a counter" and
+    // "draw a card" are exactly the distinction the per-entity head learns.
+    private static final ThreadLocal<SpellAbility> EFFECT_RECORD_SUB_ABILITY = new ThreadLocal<>();
+
+    /** The sub-ability currently resolving on this thread, or null. */
+    public static SpellAbility getEffectRecordSubAbility() {
+        return EFFECT_RECORD_SUB_ABILITY.get();
+    }
+
+    private static void setEffectRecordSubAbility(final SpellAbility sa) {
+        if (sa == null) {
+            EFFECT_RECORD_SUB_ABILITY.remove();
+        } else {
+            EFFECT_RECORD_SUB_ABILITY.set(sa);
+        }
+    }
+
     public static void resolve(final SpellAbility sa) {
         if (sa == null) {
             return;
         }
+        // Restored rather than cleared: a sub-ability can resolve another, and
+        // clearing would lose the enclosing clause on the way back up.
+        final SpellAbility previous = EFFECT_RECORD_SUB_ABILITY.get();
+        setEffectRecordSubAbility(sa);
+        try {
+            resolveEffectRecordBody(sa);
+        } finally {
+            setEffectRecordSubAbility(previous);
+        }
+    }
 
+    private static void resolveEffectRecordBody(final SpellAbility sa) {
         Player pl = sa.getActivatingPlayer();
         final Game game = pl.getGame();
 
diff --git a/forge-game/src/main/java/forge/game/replacement/ReplacementHandler.java b/forge-game/src/main/java/forge/game/replacement/ReplacementHandler.java
index 4d9877fb55b..70178d3da1a 100644
--- a/forge-game/src/main/java/forge/game/replacement/ReplacementHandler.java
+++ b/forge-game/src/main/java/forge/game/replacement/ReplacementHandler.java
@@ -58,6 +58,42 @@ public class ReplacementHandler {
     // List of all replacement effect candidates for DamageDone event, in APNAP order
     private final List<Map<ReplacementEffect, List<Map<AbilityKey, Object>>>> replaceDamageList = new ArrayList<>();
 
+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+
+    /** Notified around every replacement execution. */
+    public interface EffectRecordListener {
+        void onReplacement(ReplacementEffect effect, Map<AbilityKey, Object> before,
+                Map<AbilityKey, Object> after);
+    }
+
+    private static EffectRecordListener effectRecordListener;
+
+    public static void setEffectRecordListener(final EffectRecordListener listener) {
+        effectRecordListener = listener;
+    }
+
+    /**
+     * Deep-copy of a run-parameter map, for the "before" side.
+     *
+     * <p>Replacements mutate the nested structures in place, so a shallow copy
+     * would leave both sides showing the outgoing values and every rewrite
+     * record would claim the effect changed nothing.
+     */
+    private static Map<AbilityKey, Object> deepCopyParams(final Map<AbilityKey, Object> params) {
+        final Map<AbilityKey, Object> copy = new EnumMap<>(AbilityKey.class);
+        for (final Map.Entry<AbilityKey, Object> entry : params.entrySet()) {
+            final Object value = entry.getValue();
+            if (value instanceof Map<?, ?> nested) {
+                copy.put(entry.getKey(), new LinkedHashMap<>(nested));
+            } else if (value instanceof Collection<?> nested) {
+                copy.put(entry.getKey(), new ArrayList<>(nested));
+            } else {
+                copy.put(entry.getKey(), value);
+            }
+        }
+        return copy;
+    }
+
     /**
      * ReplacementHandler.
      * @param gameState
@@ -285,6 +321,24 @@ public class ReplacementHandler {
      *            the replacement effect to run
      */
     private ReplacementResult executeReplacement(final Map<AbilityKey, Object> runParams,
+        final ReplacementEffect replacementEffect, final Player decider) {
+        // ── effect-record instrumentation (price-predictor spec 023) ──────
+        // The one point every replacement passes through. The incoming map is
+        // deep-copied before the call because replacements mutate it in place;
+        // a shallow copy would show the outgoing values on both sides and
+        // every rewrite record would claim the effect changed nothing.
+        if (effectRecordListener == null) {
+            return executeReplacementInternal(runParams, replacementEffect, decider);
+        }
+        final Map<AbilityKey, Object> before = deepCopyParams(runParams);
+        try {
+            return executeReplacementInternal(runParams, replacementEffect, decider);
+        } finally {
+            effectRecordListener.onReplacement(replacementEffect, before, runParams);
+        }
+    }
+
