 .../java/forge/game/ability/AbilityUtils.java | 32 ++++++++++
 .../game/replacement/ReplacementHandler.java  | 54 ++++++++++++++++
 .../forge/game/trigger/TriggerHandler.java    | 61 +++++++++++++++++++
