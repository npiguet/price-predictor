diff --git a/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java b/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java
index a5298d71237..30127819b06 100644
--- a/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java
+++ b/forge-game/src/main/java/forge/game/trigger/TriggerHandler.java
@@ -51,6 +51,40 @@ public class TriggerHandler {
     private final List<TriggerWaiting> waitingTriggers = new ArrayList<>();
     private final Game game;
 
+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+    //
+    // The trigger currently being run, per thread. Effect-record collection
+    // reads it to attribute an event to the trigger that produced it rather
+    // than to whatever happened to be resolving at the time. Null outside a
+    // trigger run. A plain static so the connector can read it reflectively
+    // and keep building against an unpatched checkout.
+    private static final ThreadLocal<Trigger> EFFECT_RECORD_CAUSE = new ThreadLocal<>();
+
+    /** The trigger currently running on this thread, or null. */
+    public static Trigger getEffectRecordCause() {
+        return EFFECT_RECORD_CAUSE.get();
+    }
+
+    /** Set by the handler around a trigger run; restored in a finally. */
+    public static void setEffectRecordCause(final Trigger trigger) {
+        if (trigger == null) {
+            EFFECT_RECORD_CAUSE.remove();
+        } else {
+            EFFECT_RECORD_CAUSE.set(trigger);
+        }
+    }
+
+    /** Notified for every evaluated trigger condition, fired or not. */
+    public interface EffectRecordTriggerListener {
+        void onConditionEvaluated(Trigger trigger, Map<AbilityKey, Object> runParams, boolean fired);
+    }
+
+    private static EffectRecordTriggerListener effectRecordTriggerListener;
+
+    public static void setEffectRecordTriggerListener(final EffectRecordTriggerListener listener) {
+        effectRecordTriggerListener = listener;
+    }
+
     public TriggerHandler(final Game gameState) {
         game = gameState;
     }
@@ -386,6 +420,19 @@ public class TriggerHandler {
             return false; // Not the right mode.
         }
 
+        // ── effect-record instrumentation (price-predictor spec 023) ──────
+        // Both answers are recorded, not just the firing one: a trigger record
+        // with fired = false is what teaches the condition rather than the base
+        // rate. Notified below the mode check so the negatives drawn are
+        // same-event-type candidates rather than every trigger in the game.
+        final boolean runnable = canRunTriggerInternal(regtrig, runParams);
+        if (effectRecordTriggerListener != null) {
+            effectRecordTriggerListener.onConditionEvaluated(regtrig, runParams, runnable);
+        }
+        return runnable;
+    }
+
+    private boolean canRunTriggerInternal(final Trigger regtrig, final Map<AbilityKey, Object> runParams) {
         if (regtrig.isSuppressed()) {
             return false; // Trigger removed by effect
         }
@@ -424,6 +471,20 @@ public class TriggerHandler {
         runSingleTrigger(regtrig, runParams, null);
     }
     private void runSingleTrigger(final Trigger regtrig, final Map<AbilityKey, Object> runParams, Player controller) {
+        // ── effect-record instrumentation (price-predictor spec 023) ──────
+        // Restored rather than cleared: a trigger can fire during another
+        // trigger's run, and clearing would attribute the outer one's later
+        // events to nothing.
+        final Trigger previousCause = EFFECT_RECORD_CAUSE.get();
+        setEffectRecordCause(regtrig);
+        try {
+            runSingleTriggerBody(regtrig, runParams, controller);
+        } finally {
+            setEffectRecordCause(previousCause);
+        }
+    }
+
+    private void runSingleTriggerBody(final Trigger regtrig, final Map<AbilityKey, Object> runParams, Player controller) {
         if (controller == null) {
             controller = regtrig.getHostCard().getController();
         }
