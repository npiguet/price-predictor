diff --git a/forge-ai/src/main/java/forge/ai/AiController.java b/forge-ai/src/main/java/forge/ai/AiController.java
index f4b491e887c..bb652206a2d 100644
--- a/forge-ai/src/main/java/forge/ai/AiController.java
+++ b/forge-ai/src/main/java/forge/ai/AiController.java
@@ -101,6 +101,30 @@ public class AiController {
     private List<SpellAbility> skipped;
     private volatile boolean timeoutReached;
 
+    // ── effect-record instrumentation (price-predictor spec 023) ──────────
+
+    /**
+     * Notified with the rules-level verdict for each candidate the AI
+     * evaluated. Never with the AI's policy judgment: "another time" and "life
+     * in danger" are its opinion rather than the game's rules, and training on
+     * them would teach a model Forge's play style instead of Magic.
+     *
+     * <p>The listener must copy anything it keeps. A verdict may be abandoned
+     * mid-evaluation, and the legality check mutates the checked ability's
+     * targets, so holding the ability object is not safe.
+     */
+    public interface EffectRecordPlayabilityListener {
+        void onCandidate(SpellAbility candidate, boolean canPlay, boolean affordable,
+                boolean hasLegalTarget);
+    }
+
+    private static EffectRecordPlayabilityListener effectRecordPlayabilityListener;
+
+    public static void setEffectRecordPlayabilityListener(
+            final EffectRecordPlayabilityListener listener) {
+        effectRecordPlayabilityListener = listener;
+    }
+
     public AiController(final Player computerPlayer, final Game game0) {
         player = computerPlayer;
         game = game0;
@@ -852,6 +876,16 @@ public class AiController {
         // this is the "heaviest" check, which also sets up targets, defines X, etc.
         AiPlayDecision canPlay = canPlaySa(sa);
 
+        // ── effect-record instrumentation (price-predictor spec 023) ──────
+        // Rules-level answers only, recomputed here rather than read off the
+        // AI's decision above, which mixes in policy. Notified after canPlaySa
+        // because that is what sets up the targets the third answer reads.
+        if (effectRecordPlayabilityListener != null) {
+            effectRecordPlayabilityListener.onCandidate(sa, sa.canPlay(),
+                    ComputerUtilCost.canPayCost(sa, player, false),
+                    sa.getTargetRestrictions() == null || !sa.getTargets().isEmpty());
+        }
+
         if (canPlay != AiPlayDecision.WillPlay) {
             return canPlay;
         }
